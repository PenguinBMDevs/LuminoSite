---
import { Icon } from 'astro-icon/components';

import PageLayout from '~/layouts/PageLayout.astro';

import Brands from '~/components/widgets/Brands.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';

import { APP } from '~/config';
import { techStack } from '~/data/features';
import { getPermalink } from '~/utils/permalinks';

/** Four design principles, one card pair per row (`columns={2}`). */
const principles = [
  {
    title: '性能优先',
    description: '用 Rust 与 wgpu GPU 渲染承载百万级音符，保证 Black MIDI 场景下的稳定帧率与低延迟回放。',
    icon: 'tabler:rocket',
  },
  {
    title: '开放源码',
    description: '以 AGPL-3.0-or-later 发布，代码全部公开，欢迎社区审查、贡献与 fork。',
    icon: 'tabler:brand-github',
  },
  {
    title: '现代架构',
    description: '模块化 crate 设计，编辑器状态拆分为内聚子模块，避免历史上的 God Object 问题。',
    icon: 'tabler:box-multiple',
  },
  {
    title: '跨平台',
    description: 'Windows、macOS 与 Linux 共享同一套 Rust 核心，行为与体验保持一致。',
    icon: 'tabler:devices',
  },
];

/** Key/value facts rendered in the project info panel. */
const projectFacts = [
  { label: '许可证', value: APP.licenseName, icon: 'tabler:shield-check', highlight: true },
  { label: '语言', value: 'Rust', icon: 'tabler:brand-rust', highlight: false },
  { label: '技术栈', value: 'wgpu / iced / midir', icon: 'tabler:layers-intersect', highlight: false },
  { label: '维护者', value: 'PenguinBMDevs', icon: 'tabler:users', highlight: false },
];

/** Short freedoms spelled out on the licence panel. */
const licensePoints = [
  '可自由使用、修改与再发布',
  '分发衍生作品须以相同协议开放源代码',
  '以网络服务形式提供时同样适用',
];

/**
 * Background copy. Passed as HTML because `Content` renders it through
 * `set:html`, which keeps the paragraphs and `<strong>` emphasis readable.
 */
const projectBackground = `<p>Lumino 诞生于对高密度 MIDI 工程编辑体验的重新审视。传统编辑器在数百万音符面前常常卡顿、渲染迟滞、操作响应迟缓，创作节奏被工具打断。</p>
<p>Lumino 使用 <strong>Rust</strong> 重新构建核心数据结构与渲染管线，并基于 <strong>wgpu</strong> 与 <strong>iced</strong> 打造现代化的跨平台界面，让创作重新回到音乐本身。</p>
<p>项目采用模块化 crate 架构：从 MIDI 数据模型到实时合成，从 UI 状态机到协作同步，每个子系统都有明确的边界与职责，从结构上避免了历史上常见的 <strong>God Object</strong> 问题。</p>`;

/** Credits reuse the shared tech stack, limited to the direct dependencies. */
const creditNames = ['winit', 'wgpu', 'iced', 'midir'];
const credits = techStack.filter(({ name }) => creditNames.includes(name));

const repoLabel = APP.repository.replace('https://', '');
---

<PageLayout
  metadata={{
    title: '关于',
    description:
      '了解 Lumino 的项目背景与设计理念：为何用 Rust 重建核心数据结构与渲染管线，模块化 crate 架构如何避免 God Object，以及 AGPL-3.0-or-later 开源协议与所依赖的开源生态。',
  }}
>
  <PageHeader
    tagline="About"
    title="关于 Lumino"
    subtitle="了解 Lumino 的项目背景、设计原则、开源协议，以及它所依赖的开源生态。"
  />

  <Content tagline="项目背景" title="为 Black MIDI 而生的现代 MIDI 编辑器" content={projectBackground}>
    <div slot="visual" class="rounded-2xl border border-line bg-slate-950 p-4 shadow-xl shadow-slate-950/10">
      <div class="flex items-center justify-between gap-3 pb-3">
        <span class="font-mono text-xs tracking-wide text-slate-400">project.info</span>
        <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 font-mono text-[10px] text-emerald-400">
          开源 · free software
        </span>
      </div>

      <dl class="divide-y divide-white/5 border-t border-white/10">
        {
          projectFacts.map(({ label, value, icon, highlight }) => (
            <div class="flex items-center justify-between gap-4 py-3">
              <dt class="flex items-center gap-2 text-xs text-slate-400">
                <Icon name={icon} class="h-4 w-4 shrink-0 text-slate-500" />
                {label}
              </dt>
              <dd class:list={['text-right font-mono text-sm', highlight ? 'text-cyan-300' : 'text-slate-200']}>
                {value}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-1 flex items-center gap-2 border-t border-white/10 pt-3">
        <Icon name="tabler:git-branch" class="h-4 w-4 shrink-0 text-indigo-300" />
        <p class="font-mono text-[11px] break-all leading-relaxed text-slate-400">master · {repoLabel}</p>
      </div>
    </div>
  </Content>

  <Features
    tagline="设计原则"
    title="四条不变的坚持"
    subtitle="Lumino 的每一项技术选择，最终都服务于同一件事：让高密度 MIDI 工程编辑起来不卡顿、不将就。"
    items={principles}
    columns={2}
  />

  <Content
    id="license"
    tagline="License"
    title="开源协议"
    subtitle="Lumino 在 AGPL-3.0-or-later 下发布，代码可在 GitHub 上自由获取、审查与贡献。"
    content="AGPL-3.0-or-later 是自由软件协议：你可以再发布和/或修改 Lumino，但只要把基于它的程序作为网络服务对外提供，就必须以相同协议公开源代码。详情请见仓库根目录的 LICENSE 文件。"
    callToAction={{
      text: '查看许可证原文',
      href: APP.license,
      variant: 'secondary',
      icon: 'tabler:license',
      target: '_blank',
    }}
  >
    <div slot="visual" class="rounded-2xl border border-line bg-slate-950 p-4 shadow-xl shadow-slate-950/10">
      <div class="flex flex-col items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-6 text-center">
        <span
          class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/20 text-indigo-300 ring-1 ring-indigo-400/30"
        >
          <Icon name="tabler:shield-check" class="h-6 w-6" />
        </span>
        <div>
          <p class="font-mono text-[10px] tracking-widest text-slate-400 uppercase">License</p>
          <p class="mt-1 font-mono text-lg font-semibold break-all text-cyan-300">{APP.licenseName}</p>
        </div>
      </div>

      <ul class="mt-4 space-y-2">
        {
          licensePoints.map((point) => (
            <li class="flex items-start gap-2 text-xs leading-relaxed text-slate-400">
              <Icon name="tabler:check" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-emerald-400" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>

      <p class="mt-4 border-t border-white/10 pt-3 font-mono text-[11px] text-slate-400">LICENSE · 仓库根目录</p>
    </div>
  </Content>

  <Brands
    tagline="致谢"
    title="站在开源生态之上"
    subtitle="Lumino 直接依赖 winit 的窗口事件抽象、wgpu 的跨平台 GPU 抽象、iced 的数据驱动 UI 与 midir 的 Rust MIDI I/O。"
    items={credits}
  />

  <CallToAction
    title="准备好开始了吗？"
    subtitle="下载 Lumino 最新版本，或先到功能一览看看它如何应对百万级音符的编辑场景。"
    actions={[
      { text: '前往下载页', href: getPermalink('/download'), variant: 'primary', icon: 'tabler:download' },
      { text: '查看功能', href: getPermalink('/features'), variant: 'secondary', icon: 'tabler:arrow-right' },
    ]}
  />
</PageLayout>
