---
import PageLayout from '~/layouts/PageLayout.astro';

import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';
import Steps from '~/components/widgets/Steps.astro';

import { APP } from '~/config';
import type { Item } from '~/types';
import { getPermalink } from '~/utils/permalinks';

/**
 * 功能索引页：五个功能模块的总入口。
 *
 * 组件顺序与首页保持一致：
 * PageHeader → Features2（五张模块卡片）→ Steps（isDark，四步工作流）
 * → CallToAction（banner，免费下载）。
 */

/** 通往五个功能页的入口卡片，描述沿用旧页面文案。 */
const featurePages: Array<Item> = [
  {
    title: 'MIDI 编辑器',
    description:
      '基于钢琴卷帘的多轨编辑、音符绘制、力度调整与选择框操作，专为 Black MIDI 的高密度场景设计。',
    icon: 'tabler:piano',
    href: getPermalink('/features/editor'),
    callToAction: { text: '查看编辑器', href: getPermalink('/features/editor') },
  },
  {
    title: '渲染器',
    description:
      '音频渲染（xsynth / KDMAPI / winmm 低延迟输出）与视频渲染（wgpu GPU 加速可视化），覆盖创作到发布的完整回放链路。',
    icon: 'tabler:bolt',
    href: getPermalink('/features/performance'),
    callToAction: { text: '查看渲染器', href: getPermalink('/features/performance') },
  },
  {
    title: 'MIDI 后端',
    description: 'KDMAPI、winmm 与 xsynth 多后端同时支持，适应创作、监听与导出等不同音频输出需求。',
    icon: 'tabler:plug-connected',
    href: getPermalink('/features/backends'),
    callToAction: { text: '查看后端', href: getPermalink('/features/backends') },
  },
  {
    title: '实时协作',
    description: '多人同步编辑，自动广播音符、走带、速度、拍号与视口变化，支持项目状态快照与增量更新。',
    icon: 'tabler:users',
    href: getPermalink('/features/collaboration'),
    callToAction: { text: '查看协作', href: getPermalink('/features/collaboration') },
  },
  {
    title: '自动化轨道',
    description: 'CC、弯音等控制器曲线可视化编辑，支持添加、移动、删除与曲线形状切换，精准控制表情变化。',
    icon: 'tabler:vector-spline',
    href: getPermalink('/features/automation'),
    callToAction: { text: '查看自动化', href: getPermalink('/features/automation') },
  },
];

/** 旧页面用 01–04 四张卡片画的流程图，编号交给 `Steps` 自动生成。 */
const flowSteps: Array<Item> = [
  {
    title: '编辑器',
    description: '在多轨钢琴卷帘中绘制音符、调整力度，用选择框批量移动与编辑，灵感不再被工具打断。',
    icon: 'tabler:piano',
  },
  {
    title: '渲染器',
    description: '音频渲染支持 xsynth、KDMAPI、winmm 多后端低延迟输出；视频渲染基于 wgpu 实现 GPU 加速可视化。',
    icon: 'tabler:gpu',
  },
  {
    title: '协作',
    description: '邀请他人加入工程，同步视口、走带与音符变更，多人共同完成复杂编排。',
    icon: 'tabler:users',
  },
  {
    title: '导出',
    description: '把完成的工程导出为标准 MIDI 文件，或借助后续计划中的音频导出功能直接生成成品。',
    icon: 'tabler:file-music',
  },
];
---

<PageLayout
  metadata={{
    title: '功能特性',
    description:
      'Lumino 将 Rust 的性能优势与现代 MIDI 工作流结合：钢琴卷帘编辑器、GPU 加速渲染器、多后端 MIDI I/O、实时协作与自动化轨道，从创作到发布，每个环节都有独立打磨的模块。',
  }}
>
  <PageHeader
    tagline="Features"
    title="功能特性"
    subtitle="Lumino 把 Rust 的性能优势与现代 MIDI 工作流结合，每个模块独立打磨，覆盖从创作到发布的各个环节。"
  />

  <Features2
    tagline="功能模块"
    title="五项核心能力，一条完整工作流"
    subtitle="从钢琴卷帘到实时协作，五个模块各自独立，点击任意一张卡片继续深入。"
    items={featurePages}
    columns={3}
  />

  <Steps
    isDark
    tagline="工作流"
    title="从编辑到导出，四步完成"
    subtitle="编辑、渲染、协作与导出串成一条顺畅的流水线，每一步都不必离开 Lumino。"
    items={flowSteps}
  />

  <CallToAction
    layout="banner"
    title="免费下载，马上开始编排"
    subtitle="Lumino 在 Windows、macOS 与 Linux 上均可运行，内置 KDMAPI、winmm 与 xsynth 多后端音频输出。"
    actions={[
      { text: '免费下载', href: APP.releases, variant: 'primary', icon: 'tabler:download', target: '_blank' },
      { text: '查看 GitHub', href: APP.repository, variant: 'secondary', icon: 'tabler:brand-github', target: '_blank' },
    ]}
  />
</PageLayout>
