---
import PageLayout from '~/layouts/PageLayout.astro';

import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Metrics from '~/components/widgets/Metrics.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';

import { getPermalink } from '~/utils/permalinks';

/**
 * 渲染器页：音频与视频双渲染管线。
 *
 * 组件顺序与首页保持一致：
 * PageHeader → Content（双通道分流示意）→ Metrics（isDark，SoA 数据指标）
 * → Content（isReversed，note_store.rs 代码）→ Features（音频 / 视频两组特性）
 * → CallToAction（引导至 MIDI 后端页）。
 */

const renderMetrics = [
  { amount: '8 线程', title: '并行批量移动', description: '批量移动与删除按数据分片并行执行，互不重叠。' },
  { amount: '10,000+', title: 'SoA 切换阈值', description: '音符数超过阈值后自动采用结构体数组布局。' },
  { amount: '< 1ms', title: '目标音频延迟', description: 'KDMAPI 后端面向极限事件吞吐优化。' },
  { amount: 'wgpu', title: '跨平台 GPU 抽象', description: '同一渲染管线覆盖三大桌面平台。' },
];

/** 数据布局的三条批量操作，与下方代码示例一一对应。 */
const layoutItems = [
  {
    title: '批量移动',
    description: '按数据分片并行执行，8 线程同时处理互不重叠的区间。',
    icon: 'tabler:repeat',
  },
  {
    title: '批量删除',
    description: '单次 O(N) 遍历完成，不需要逐条查找与搬移。',
    icon: 'tabler:eraser',
  },
  {
    title: '批量插入',
    description: '预分配容量，插入过程不触发 realloc。',
    icon: 'tabler:layers-intersect',
  },
];

/** 音频通道（xsynth / KDMAPI / winmm）与视频通道（wgpu / iced / Canvas / 跨平台）。 */
const renderFeatures = [
  {
    title: 'xsynth 纯软件合成',
    description: '基于 SoundFont 实时渲染，无硬件 MIDI 设备也能获得跨平台一致的音色。',
    icon: 'tabler:waveform',
  },
  {
    title: 'KDMAPI 极限吞吐',
    description: '绕过传统 winmm 限制直达驱动，面向 Black MIDI 的高并发事件场景优化。',
    icon: 'tabler:bolt',
  },
  {
    title: 'winmm 原生兼容',
    description: '系统级原生 MIDI 输出，兼容性最广，无需额外驱动即可通用回放。',
    icon: 'tabler:brand-windows',
  },
  {
    title: 'wgpu GPU 加速',
    description: '跨平台 GPU 绘制管线，音符与网格的渲染批次经过合并优化，降低 CPU 开销。',
    icon: 'tabler:gpu',
  },
  {
    title: 'iced 声明式 UI',
    description: '数据驱动的声明式界面框架，界面状态随音符数据单向同步刷新。',
    icon: 'tabler:layout-2',
  },
  {
    title: 'Canvas 自定义绘制',
    description: '钢琴卷帘由 Canvas 级自定义绘制完成，细节控制不受通用组件库限制。',
    icon: 'tabler:brush',
  },
  {
    title: '跨平台统一抽象',
    description: 'Windows、macOS 与 Linux 共用同一套渲染管线与后端接口。',
    icon: 'tabler:devices',
  },
];
---

<PageLayout
  metadata={{
    title: '渲染器',
    description:
      'Lumino 渲染器由音频与视频双管线构成：音频侧经 xsynth、KDMAPI 与 winmm 输出低延迟回放，视频侧基于 wgpu 与 iced 完成 GPU 加速可视化与钢琴卷帘绘制，跨平台一致。',
  }}
>
  <PageHeader
    badge="双通道渲染"
    tagline="Renderer"
    title="渲染器"
    subtitle="音频与视频双通道渲染引擎：音频通道负责低延迟回放，视频通道负责 GPU 加速可视化，覆盖创作流程的每一个输出环节。"
  />

  <Content
    tagline="Dual-channel"
    title="音频 + 视频双渲染管线"
    subtitle="渲染器不是单一模块，而是由音频输出子系统与视频可视化子系统协同构成的完整管线。"
    content="编辑器的每一次修改都会同时驱动两条通道：音频通道把音符事件即时送往所选后端，让你立刻听到结果；视频通道在同一帧内重绘音符、网格与视口，让变化立刻可见。两条通道共享同一份音符数据，因此聆听与画面始终同步，不会出现视听错位。"
  >
    <div
      slot="visual"
      class="overflow-hidden rounded-2xl border border-line bg-slate-950 shadow-xl shadow-slate-950/10"
    >
      <div class="flex items-center justify-between border-b border-white/10 bg-slate-900/70 px-4 py-3">
        <span class="font-mono text-xs tracking-wide text-slate-400">render-pipeline</span>
        <span class="rounded-full bg-primary/15 px-2 py-0.5 font-mono text-[10px] text-indigo-300">双通道</span>
      </div>
      <div class="flex flex-col items-center p-4 sm:p-6">
        <div class="w-full rounded-xl border border-indigo-400/30 bg-indigo-500/10 px-4 py-3 text-center">
          <p class="font-mono text-sm font-semibold tracking-wide text-indigo-200">Lumino Editor</p>
          <p class="mt-1 text-[11px] text-slate-400">音符 / 走带 / 视口状态</p>
        </div>

        <div class="relative h-9 w-full" aria-hidden="true">
          <div class="absolute top-0 left-1/2 h-3 w-px -translate-x-1/2 bg-white/20"></div>
          <div class="absolute top-3 right-1/4 left-1/4 h-px bg-white/20"></div>
          <div class="absolute top-3 left-1/4 h-6 w-px bg-cyan-400/50"></div>
          <div class="absolute top-3 left-3/4 h-6 w-px bg-indigo-400/50"></div>
        </div>

        <div class="grid w-full grid-cols-2 gap-3">
          <div class="rounded-xl border border-cyan-400/25 bg-cyan-500/10 px-3 py-3 text-center">
            <p class="text-xs font-semibold tracking-wide text-cyan-200">音频渲染</p>
            <p class="mt-1 font-mono text-[10px] leading-relaxed text-slate-400">
              xsynth · KDMAPI<br />winmm
            </p>
          </div>
          <div class="rounded-xl border border-indigo-400/25 bg-indigo-500/10 px-3 py-3 text-center">
            <p class="text-xs font-semibold tracking-wide text-indigo-200">视频渲染</p>
            <p class="mt-1 font-mono text-[10px] leading-relaxed text-slate-400">
              wgpu · iced<br />Canvas
            </p>
          </div>
        </div>
      </div>
    </div>
  </Content>

  <Metrics
    isDark
    tagline="Data Layout"
    title="为高密度工程而设计"
    subtitle="当音符数量超过阈值时自动切换到结构体数组（SoA）存储，结合多线程并行处理，确保渲染线程永不阻塞。"
    metrics={renderMetrics}
  />

  <Content
    isReversed
    tagline="SoA 存储"
    title="批量存储，多线程并行"
    subtitle="超过 10,000 个音符后切换为列式布局，批量操作退化为对连续内存的顺序遍历。"
    content="低于阈值时音符以紧凑的结构体数组保存，超过阈值后切换为结构体数组的列式布局（SoA），把音高、起点、时长与力度分别存进独立的连续数组。批量移动、删除与插入因此都能按分片并行执行，渲染线程只读取自己需要的那一列，在高密度工程下依旧保持稳定帧率。"
    items={layoutItems}
  >
    <div
      slot="visual"
      class="overflow-hidden rounded-2xl border border-line bg-slate-950 shadow-xl shadow-slate-950/10"
    >
      <div class="flex items-center gap-2 border-b border-white/10 bg-slate-900/70 px-4 py-3">
        <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
        <span class="ml-auto font-mono text-xs tracking-wide text-slate-400">note_store.rs</span>
      </div>
      <pre class="overflow-x-auto p-4 font-mono text-xs leading-6 text-slate-300"><code><span class="text-slate-500">// 当音符数超过阈值时启用 SoA 批量操作</span>
<span class="text-indigo-300">pub const</span> NOTE_STORE_THRESHOLD: <span class="text-cyan-300">usize</span> = <span class="text-emerald-300">10_000</span>;

<span class="text-slate-500">// 批量移动：8 线程并行，16M 音符 50% 18ms</span>
note_store.<span class="text-indigo-300">batch_move_parallel</span>(offset, selected);

<span class="text-slate-500">// 批量删除：O(N) 单次遍历</span>
note_store.<span class="text-indigo-300">delete_selected</span>(indices);

<span class="text-slate-500">// 批量插入：无 realloc，1ms/1000 音符</span>
note_store.<span class="text-indigo-300">insert_bulk</span>(notes);</code></pre>
    </div>
  </Content>

  <Features
    tagline="双通道特性"
    title="音频与视频，各司其职"
    subtitle="一条通道负责听，一条通道负责看：音频后端决定延迟与音色，渲染管线决定帧率与细节。"
    items={renderFeatures}
    columns={2}
  />

  <CallToAction
    title="后端决定输出，渲染器决定体验"
    subtitle="音频通道的具体输出方式由 MIDI 后端决定。了解 KDMAPI、winmm 与 xsynth 的差异，为你的工程选择最合适的后端。"
    actions={[
      {
        text: '查看 MIDI 后端',
        href: getPermalink('/features/backends'),
        variant: 'primary',
        icon: 'tabler:arrow-right',
      },
    ]}
  />
</PageLayout>
