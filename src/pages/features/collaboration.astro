---
import PageLayout from '~/layouts/PageLayout.astro';

import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';
import Timeline from '~/components/widgets/Timeline.astro';

import { APP } from '~/config';
import type { Item, TimelineEntry } from '~/types';
import { getPermalink } from '~/utils/permalinks';

/**
 * Peers rendered in the dark session panel. Colours are plain utility strings so
 * Tailwind can pick them up from the source file.
 */
const members = [
  {
    initial: 'A',
    name: '你 (Host)',
    role: 'Host · 指挥者',
    status: '编辑中',
    statusClass: 'text-emerald-300',
    dotClass: 'bg-emerald-400',
    avatarClass: 'from-indigo-400 to-violet-500',
  },
  {
    initial: 'B',
    name: '协作者 B',
    role: 'Guest · 跟随',
    status: '同步中',
    statusClass: 'text-cyan-300',
    dotClass: 'bg-cyan-400 animate-pulse',
    avatarClass: 'from-cyan-400 to-sky-500',
  },
  {
    initial: 'C',
    name: '协作者 C',
    role: 'Guest · 跟随',
    status: '在线',
    statusClass: 'text-slate-300',
    dotClass: 'bg-slate-400',
    avatarClass: 'from-violet-400 to-fuchsia-500',
  },
];

/** The six `ProjectUpdate` variants broadcast between peers. */
const updateTypes: Array<TimelineEntry> = [
  {
    label: 'ViewState',
    title: '视口与滚动位置',
    description: '缩放比例、滚动偏移与可视时间范围变化时广播，跟随模式会据此对齐协作者视图。',
    icon: 'tabler:window-maximize',
  },
  {
    label: 'Track',
    title: '音轨音符变更',
    description: '音符的新增、移动、删除与力度调整以音轨为单位批量下发。',
    icon: 'tabler:piano',
  },
  {
    label: 'Tempo',
    title: '速度变化',
    description: 'BPM 与速度映射调整即时同步，保证所有人的走带时间轴一致。',
    icon: 'tabler:gauge',
  },
  {
    label: 'TimeSignature',
    title: '拍号变化',
    description: '拍号切换同步到全部客户端，小节划分与编辑网格不再错位。',
    icon: 'tabler:clock',
  },
  {
    label: 'Metadata',
    title: '工程元数据',
    description: '工程名称、轨道信息与编辑偏好等轻量数据随变更一同广播。',
    icon: 'tabler:info-circle',
  },
  {
    label: 'Full',
    title: '完整工程快照',
    description: '新成员加入或需要回溯时，一次性下发完整工程用于状态对齐。',
    icon: 'tabler:database',
  },
];

/** Transport and consistency layers behind the sync loop. */
const syncFeatures: Array<Item> = [
  {
    title: 'WebSocket 或本地网络通道',
    description: '更新以二进制或 JSON 形式在通道中传输，既能跨越公网，也能在同一局域网内低延迟直连。',
    icon: 'tabler:network',
  },
  {
    title: '增量同步',
    description: '仅发送发生变更的部分，显著降低带宽占用与同步抖动，工程规模越大收益越明显。',
    icon: 'tabler:git-branch',
  },
  {
    title: '项目状态快照',
    description: '随时生成完整工程快照，便于回溯历史版本、处理冲突，也让新成员快速对齐现场。',
    icon: 'tabler:device-floppy',
  },
  {
    title: '视口同步',
    description: '指挥者模式与跟随模式可选，协作者的视口会随指挥者自动对齐到同一段乐谱。',
    icon: 'tabler:world',
  },
];
---

<PageLayout
  metadata={{
    title: '实时协作',
    description:
      'Lumino 将工程拆分为可独立广播的更新类型，通过 WebSocket 或本地网络通道传输增量变更，配合项目状态快照与视口同步，让多人协作编辑同一 Black MIDI 工程时始终保持一致。',
  }}
>
  <PageHeader
    tagline="Collaboration"
    title="实时协作"
    subtitle="多人同步编辑同一 MIDI 工程，变更自动广播，团队协作无缝衔接。"
  />

  <Content
    tagline="ProjectUpdate"
    title="一起创作，变更即时同步"
    subtitle="多人同时编辑同一工程，每一次操作都会即时抵达其他人的屏幕。"
    content="Lumino 将工程拆分为多个可独立广播的更新类型。当一位用户移动音符、调整速度或滚动视口时，其他协作者会立即收到增量更新，无需手动刷新，也不必反复保存版本。所有变更经由结构化的 ProjectUpdate 消息流转：需要回溯时可以请求项目状态快照，视口同步则让所有人始终看向同一段乐谱。"
    callToAction={{
      text: '了解编辑器架构',
      href: getPermalink('/features/editor'),
      variant: 'secondary',
      icon: 'tabler:arrow-right',
    }}
  >
    <div slot="visual" class="rounded-2xl border border-line bg-slate-950 p-4 shadow-xl shadow-slate-950/10">
      <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-3">
        <div class="flex min-w-0 items-center gap-2">
          <span class="relative flex h-2 w-2 shrink-0">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
          </span>
          <span class="truncate font-mono text-xs text-slate-200">lumino · shared session</span>
        </div>
        <span class="shrink-0 rounded-full border border-white/10 bg-white/5 px-2 py-0.5 font-mono text-[10px] text-slate-400">
          3 位参与者
        </span>
      </div>

      <ul class="mt-3 space-y-2">
        {
          members.map((member) => (
            <li class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-3 py-2.5">
              <span
                class:list={[
                  'flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br font-mono text-xs font-bold text-slate-950',
                  member.avatarClass,
                ]}
              >
                {member.initial}
              </span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-medium text-slate-200">{member.name}</p>
                <p class="truncate font-mono text-[11px] text-slate-400">{member.role}</p>
              </div>
              <span class="flex shrink-0 items-center gap-1.5">
                <span class:list={['h-1.5 w-1.5 rounded-full', member.dotClass]}></span>
                <span class:list={['text-xs', member.statusClass]}>{member.status}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <div class="mt-3 flex items-center justify-between gap-3 rounded-xl border border-indigo-400/25 bg-indigo-500/10 px-3 py-2.5">
        <span class="flex items-center gap-2 text-xs font-semibold text-indigo-300">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>
          实时同步已开启
        </span>
        <span class="font-mono text-[10px] text-cyan-300">ViewState · 增量</span>
      </div>
    </div>
  </Content>

  <Timeline
    tagline="Update Types"
    title="结构化更新类型"
    subtitle="每种变更都有明确的类型与数据结构，便于扩展、调试和版本管理。"
    items={updateTypes}
  />

  <Features
    tagline="同步机制"
    title="让协作像一个人在操作"
    subtitle="从传输通道到冲突处理，每一层都为实时编辑而设计。"
    items={syncFeatures}
    columns={2}
  />

  <CallToAction
    title="与团队一起完成下一个作品"
    subtitle="Lumino 在 Windows、macOS 与 Linux 上均可运行。下载最新版本，把协作者拉进同一个工程。"
    actions={[
      { text: '免费下载', href: APP.releases, variant: 'primary', icon: 'tabler:download', target: '_blank' },
      { text: '浏览全部功能', href: getPermalink('/features'), variant: 'secondary', icon: 'tabler:arrow-right' },
    ]}
  />
</PageLayout>
