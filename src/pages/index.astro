---
import PageLayout from '~/layouts/PageLayout.astro';

import Brands from '~/components/widgets/Brands.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Metrics from '~/components/widgets/Metrics.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps from '~/components/widgets/Steps.astro';

import heroScreenshot from '~/assets/images/hero-screenshot.png';
import { APP } from '~/config';
import { featureItems, techStack, workflowSteps } from '~/data/features';
import { getPermalink } from '~/utils/permalinks';

const reasons = [
  {
    title: '性能优先',
    description: 'Rust 核心配合 wgpu GPU 渲染，在百万级音符工程下依旧保持交互流畅。',
    icon: 'tabler:rocket',
  },
  {
    title: '模块化架构',
    description: '编辑器状态拆分为内聚子模块，避免历史上的 God Object 问题。',
    icon: 'tabler:box-multiple',
  },
  {
    title: '跨平台一致',
    description: 'Windows、macOS 与 Linux 共享同一套 Rust 核心与渲染管线。',
    icon: 'tabler:devices',
  },
];

const stateModules = [
  { name: 'CanvasState', desc: '几何状态与视口滚动' },
  { name: 'EditorData', desc: '音符数据与音轨缓存' },
  { name: 'InteractionState', desc: '交互状态机与命中检测' },
  { name: 'History', desc: '撤销 / 重做快照' },
];

const faqs = [
  {
    title: 'Lumino 支持哪些平台？',
    description: 'Windows、macOS 与 Linux 共享同一套 Rust 核心，发布包覆盖 x86_64 与 aarch64（Apple Silicon）架构。',
  },
  {
    title: 'Lumino 是免费的吗？',
    description: `Lumino 以 ${APP.licenseName} 发布，可自由使用、修改与分发；基于它提供的网络服务需要以相同协议公开源代码。`,
  },
  {
    title: '能否处理百万级音符的 Black MIDI 工程？',
    description: '当音符数量超过阈值时，编辑器会自动切换到结构体数组（SoA）存储，并用多线程并行执行批量操作，避免渲染线程被阻塞。',
  },
  {
    title: '支持哪些 MIDI 输出后端？',
    description: '支持 KDMAPI（面向 Black MIDI 的超低延迟）、winmm（系统原生兼容）与 xsynth（跨平台软件合成）三种后端，可在运行时切换。',
  },
  {
    title: '如何从源码构建？',
    description: '克隆仓库后执行 cargo build --release 即可，Windows 需要 MSVC 构建工具，macOS 需要 Xcode Command Line Tools，Linux 需要 GCC/Clang 与 pkg-config。',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Lumino',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Windows, macOS, Linux',
  description:
    'Lumino 是一个使用 Rust 构建的跨平台 MIDI 编辑器，基于 wgpu 与 iced，面向 Black MIDI 高密度工程。',
  license: APP.license,
  url: APP.repository,
  downloadUrl: APP.releases,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
};
---

<PageLayout
  metadata={{
    title: '为 Black MIDI 打造的新一代 MIDI 编辑器',
    ignoreTitleTemplate: true,
    description:
      'Lumino 是一个使用 Rust 构建的跨平台 MIDI 编辑器，基于 wgpu 与 iced，面向 Black MIDI 高密度工程，提供低延迟渲染、多后端 MIDI I/O 与实时协作。',
    openGraph: {
      images: [{ url: heroScreenshot.src, width: 1920, height: 1032, alt: 'Lumino MIDI 编辑器钢琴卷帘界面' }],
    },
  }}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Hero
    badge="Rust 构建 · 跨平台 · GPU 加速"
    title="为 Black MIDI 打造的<br /><span class='text-primary dark:text-accent'>新一代 MIDI 编辑器</span>"
    subtitle="Lumino 使用 Rust 构建，基于 wgpu 与 iced 技术栈，提供低延迟、高性能的跨平台 MIDI 编辑体验。多轨编辑、音符绘制、力度调整与实时协作，一气呵成。"
    actions={[
      { text: '免费下载', href: APP.releases, variant: 'primary', icon: 'tabler:download', target: '_blank' },
      { text: '探索功能', href: getPermalink('/features'), variant: 'secondary', icon: 'tabler:arrow-right' },
    ]}
    image={{ src: heroScreenshot, alt: 'Lumino MIDI 编辑器钢琴卷帘界面' }}
  />

  <Stats
    tagline="用数据说话"
    stats={[
      { amount: '< 1ms', title: '目标音频延迟' },
      { amount: '10,000+', title: 'SoA 存储切换阈值' },
      { amount: '8 线程', title: '并行批量操作' },
      { amount: '3', title: 'Windows / macOS / Linux' },
    ]}
  />

  <Features2
    tagline="功能一览"
    title="每一项，都为创作打磨"
    subtitle="从音符输入到混音导出，Lumino 提供完整的工作流支持。"
    items={featureItems}
    columns={3}
  />

  <Content
    tagline="为什么选 Lumino"
    title="Rust 的核心，为速度而生"
    content="传统 MIDI 编辑器在处理 Black MIDI 级别的超高密度音符时往往力不从心。Lumino 以编辑器和渲染器两大核心驱动工作流：编辑器提供钢琴卷帘与多轨编排，渲染器涵盖音频低延迟输出与 GPU 加速可视化，让复杂工程也能流畅编辑与回放。"
    items={reasons}
    callToAction={{
      text: '了解编辑器架构',
      href: getPermalink('/features/editor'),
      variant: 'secondary',
      icon: 'tabler:arrow-right',
    }}
  >
    <div slot="visual" class="overflow-hidden rounded-2xl border border-line bg-slate-950 shadow-xl shadow-slate-950/10">
      <div class="flex items-center justify-between border-b border-white/10 bg-slate-900/70 px-4 py-3">
        <span class="font-mono text-xs tracking-wide text-slate-400">editor-state</span>
        <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 font-mono text-[10px] text-emerald-400">
          分层 / 无 God Object
        </span>
      </div>
      <ul class="divide-y divide-white/5 p-2">
        {
          stateModules.map((module) => (
            <li class="flex items-center gap-3 rounded-lg px-3 py-3 transition hover:bg-white/5">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-primary/15 font-mono text-[10px] text-indigo-300">
                {module.name.slice(0, 2)}
              </span>
              <div class="min-w-0">
                <p class="font-mono text-sm text-slate-200">{module.name}</p>
                <p class="text-xs text-slate-400">{module.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Content>

  <Steps
    tagline="工作流"
    title="从灵感到成品，四步完成"
    subtitle="Lumino 把编辑、试听、协作与导出串成一条顺畅的流水线。"
    items={workflowSteps}
  />

  <Metrics
    isDark
    tagline="Data Layout"
    title="为高密度工程而设计"
    subtitle="当音符数量超过阈值时自动切换到结构体数组（SoA）存储，结合多线程并行处理，确保渲染线程永不阻塞。"
    metrics={[
      { amount: '8 线程', title: '并行批量移动', description: '批量移动与删除按数据分片并行执行。' },
      { amount: '10,000+', title: 'SoA 切换阈值', description: '超过阈值后启用结构体数组布局。' },
      { amount: '< 1ms', title: '目标音频延迟', description: 'KDMAPI 后端面向极限事件吞吐优化。' },
      { amount: 'wgpu', title: '跨平台 GPU 抽象', description: '同一渲染管线覆盖三大桌面平台。' },
    ]}
  />

  <Brands
    tagline="技术栈"
    title="站在成熟生态之上"
    subtitle="Lumino 由一组经过验证的 Rust 库驱动，从窗口、GPU 到 MIDI I/O 全部开源。"
    items={techStack}
  />

  <FAQs
    tagline="常见问题"
    title="还有疑问？"
    subtitle="关于平台、许可与性能的几个常见问题。"
    items={faqs}
  />

  <CallToAction
    layout="banner"
    title="准备好开始了吗？"
    subtitle="Lumino 在 Windows、macOS 与 Linux 上均可运行。下载最新版本，开启你的 Black MIDI 创作之旅。"
    actions={[
      { text: '下载 Lumino', href: APP.releases, variant: 'primary', icon: 'tabler:download', target: '_blank' },
      { text: '查看 GitHub', href: APP.repository, variant: 'secondary', icon: 'tabler:brand-github', target: '_blank' },
    ]}
  />
</PageLayout>
