---
import Platforms from '~/components/pages/Platforms.astro';
import PageLayout from '~/layouts/PageLayout.astro';

import { getDictionary, type Lang } from '~/i18n/ui';

const lang: Lang = 'en';
const t = getDictionary(lang);
---

<PageLayout lang={lang} title={t.meta.platforms.title} description={t.meta.platforms.description}>
  <Platforms lang={lang} />
</PageLayout>
