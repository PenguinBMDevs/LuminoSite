---
import { Icon } from 'astro-icon/components';

import PageLayout from '~/layouts/PageLayout.astro';

import Button from '~/components/ui/Button.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Note from '~/components/widgets/Note.astro';
import PageHeader from '~/components/widgets/PageHeader.astro';

import { APP } from '~/config';
import { getPermalink } from '~/utils/permalinks';

/**
 * Platform matrix. Architectures and package formats mirror what the release
 * pipeline publishes; keep them in sync with the GitHub Releases page.
 */
const platforms = [
  {
    os: 'Windows',
    icon: 'tabler:brand-windows',
    archs: ['x86_64', 'aarch64'],
    note: '推荐 Windows 10 / 11，内置 KDMAPI 与 winmm 后端，也可切换 xsynth。',
  },
  {
    os: 'macOS',
    icon: 'tabler:brand-apple',
    archs: ['x86_64', 'Apple Silicon'],
    note: 'Intel 与 Apple Silicon 双架构，使用 xsynth 后端预览。',
  },
  {
    os: 'Linux',
    icon: 'tabler:brand-ubuntu',
    archs: ['x86_64', 'aarch64'],
    note: '提供 AppImage、deb 与 rpm 三种安装包。',
  },
];

/** Capabilities bundled in the current stable build. */
const capabilities = [
  { label: 'MIDI 编辑器', icon: 'tabler:piano' },
  { label: '多后端预览', icon: 'tabler:plug-connected' },
  { label: '自动化轨道', icon: 'tabler:vector-spline' },
  { label: '配置持久化', icon: 'tabler:device-floppy' },
];

/** Toolchain prerequisites for a local `cargo build`. */
const requirements = [
  {
    title: 'Rust 1.94.0+',
    description: '从源码构建需要最新的稳定版工具链，可用 rustup 安装。',
    icon: 'tabler:brand-rust',
  },
  {
    title: 'Windows：MSVC / VS Build Tools',
    description: '需安装 Visual Studio Build Tools，并勾选「使用 C++ 的桌面开发」工作负载。',
    icon: 'tabler:brand-windows',
  },
  {
    title: 'macOS：Xcode Command Line Tools',
    description: '执行 xcode-select --install 即可获得系统编译工具链。',
    icon: 'tabler:brand-apple',
  },
  {
    title: 'Linux：GCC / Clang、pkg-config',
    description: '音频与窗口相关依赖的编译前提，可用发行版包管理器安装。',
    icon: 'tabler:brand-ubuntu',
  },
];

/** Commands rendered inside the terminal panel, split so the verb can be tinted. */
const buildCommands = [
  { cmd: 'git clone', args: 'https://github.com/PenguinBMDevs/lumino-rs.git' },
  { cmd: 'cd', args: 'lumino-rs' },
  { cmd: 'cargo build', args: '--release' },
  { cmd: 'cargo run', args: '--release' },
];
---

<PageLayout
  metadata={{
    title: '下载',
    description:
      '下载 Lumino 最新版本：Windows 提供 KDMAPI 与 winmm 后端，macOS 使用 xsynth 预览，Linux 提供 AppImage、deb 与 rpm 安装包，并支持用 cargo 从源码构建。',
  }}
>
  <PageHeader
    tagline="Download"
    title="下载 Lumino"
    subtitle="选择与你的系统匹配的安装包，或直接用 cargo 从源码构建。Windows、macOS 与 Linux 共享同一套 Rust 核心与渲染管线。"
    actions={[
      {
        text: '前往 GitHub Releases',
        href: APP.releases,
        variant: 'primary',
        icon: 'tabler:download',
        target: '_blank',
      },
    ]}
  />

  <section class="relative not-prose">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-20 lg:px-8">
      <div class="relative overflow-hidden rounded-2xl border border-line bg-surface p-6 md:p-10">
        <div
          class="pointer-events-none absolute -top-28 -right-24 h-72 w-72 rounded-full bg-primary/10 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div class="relative grid gap-10 lg:grid-cols-2 lg:gap-14">
          <div class="flex flex-col items-start">
            <span
              class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-xs font-semibold text-primary dark:text-indigo-200"
            >
              <Icon name="tabler:package" class="h-4 w-4" />
              {APP.version}
            </span>

            <h2 class="mt-4 font-heading text-3xl leading-tighter font-bold tracking-tight text-heading md:text-4xl">
              最新稳定版本
            </h2>

            <p class="mt-4 leading-relaxed text-muted">
              包含 MIDI 编辑器、多后端预览、自动化轨道与配置持久化等核心能力，安装后即可打开标准 MIDI 工程开始编辑。
            </p>

            <ul class="mt-6 flex flex-wrap gap-2">
              {
                capabilities.map(({ label, icon }) => (
                  <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-page px-3 py-1 text-xs text-muted">
                    <Icon name={icon} class="h-3.5 w-3.5 text-primary" />
                    {label}
                  </li>
                ))
              }
            </ul>

            <div class="mt-8">
              <Button variant="primary" icon="tabler:download" text="获取安装包" href={APP.releases} target="_blank" />
            </div>

            <p class="mt-3 font-mono text-[11px] text-muted">安装包统一发布于 GitHub Releases 页面</p>
          </div>

          <div class="flex flex-col gap-4">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <p class="font-mono text-xs font-bold tracking-widest text-secondary uppercase dark:text-accent">
                可用平台
              </p>
              <span class="text-xs text-muted">选择与系统匹配的安装包</span>
            </div>

            <ul class="flex flex-col gap-3">
              {
                platforms.map((platform) => (
                  <li class="flex flex-col gap-3 rounded-xl border border-line bg-page p-4 transition hover:border-primary/30 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex items-start gap-3">
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary ring-1 ring-primary/20">
                        <Icon name={platform.icon} class="h-5 w-5" />
                      </span>
                      <div class="min-w-0">
                        <p class="font-semibold text-heading">{platform.os}</p>
                        <div class="mt-1.5 flex flex-wrap gap-1.5">
                          {platform.archs.map((arch) => (
                            <span class="rounded-md border border-line px-1.5 py-0.5 font-mono text-[11px] text-muted">
                              {arch}
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                    <p class="text-sm leading-relaxed text-muted sm:max-w-[17rem] sm:text-right">{platform.note}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Content
    tagline="Source Build"
    title="从源码构建"
    subtitle="Lumino 完全开源，克隆仓库后即可用 cargo 编译出与发布版本一致的可执行文件。"
    content="构建前请确认本机已具备对应平台的编译工具链；首次 <strong>release</strong> 构建需要编译全部依赖，耗时通常在数分钟内。"
    items={requirements}
  >
    <div slot="visual" class="rounded-2xl border border-line bg-slate-950 p-4 shadow-xl shadow-slate-950/10">
      <div class="flex items-center gap-2 pb-3">
        <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
        <span class="ml-auto font-mono text-[11px] text-slate-400">bash · lumino-rs</span>
      </div>

      <div class="space-y-1.5 border-t border-white/10 pt-3">
        {
          buildCommands.map(({ cmd, args }) => (
            <div class="flex items-start gap-2 font-mono text-sm leading-relaxed">
              <span class="shrink-0 text-slate-500 select-none">$</span>
              <span class="flex min-w-0 flex-wrap items-baseline gap-x-2">
                <span class="text-indigo-300">{cmd}</span>
                <span class="break-all text-slate-200">{args}</span>
              </span>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-2">
        <Icon name="tabler:terminal-2" class="h-4 w-4 shrink-0 text-cyan-300" />
        <p class="font-mono text-[11px] leading-relaxed text-slate-400">
          构建产物位于 target/release/，可直接运行
        </p>
      </div>
    </div>
  </Content>

  <Note
    title="如何选择安装包"
    text="Releases 页面提供多个平台与架构的构建产物，请选择与你的操作系统和 CPU 架构匹配的文件：Windows 区分 x86_64 与 aarch64，macOS 区分 Intel 与 Apple Silicon。Linux 用户可优先下载 AppImage，免安装直接运行。"
    icon="tabler:info-circle"
    link={{ text: '前往 GitHub Releases', href: APP.releases, target: '_blank' }}
  />

  <CallToAction
    layout="banner"
    title="下载完成，开始创作"
    subtitle="Lumino 在 Windows、macOS 与 Linux 上均可运行，跨平台共享同一套 Rust 核心与渲染管线。"
    actions={[
      {
        text: '下载最新版本',
        href: APP.releases,
        variant: 'primary',
        icon: 'tabler:download',
        target: '_blank',
      },
      { text: '浏览核心功能', href: getPermalink('/features'), variant: 'secondary', icon: 'tabler:arrow-right' },
    ]}
  />
</PageLayout>
