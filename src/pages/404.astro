---
import Button from '~/components/ui/Button.astro';
import PageLayout from '~/layouts/PageLayout.astro';

import { getDictionary, type Lang } from '~/i18n/ui';

const lang: Lang = 'zh';
const t = getDictionary(lang);
const en = getDictionary('en');
---

<PageLayout
  lang={lang}
  title={t.meta.notFound.title}
  description={t.meta.notFound.description}
  robots={{ index: false, follow: false }}
>
  <section class="relative overflow-hidden px-4 py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -top-40 left-1/2 h-80 w-[48rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl dark:bg-primary/20"
      >
      </div>
    </div>

    <div class="relative mx-auto max-w-xl text-center">
      <p class="font-mono text-sm font-semibold tracking-[0.3em] text-primary uppercase dark:text-accent">
        {t.notFound.eyebrow}
      </p>
      <h1 class="mt-4 font-heading text-4xl font-bold tracking-tight text-heading md:text-5xl">{t.notFound.title}</h1>
      <p class="mt-4 text-muted">{t.notFound.text}</p>
      <p class="mt-1 text-sm text-muted/80">{en.notFound.title} — {en.notFound.text}</p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button text={t.notFound.backHome} href="/" variant="primary" icon="tabler:home" />
        <Button text={en.notFound.backHome} href="/en/" variant="secondary" icon="tabler:arrow-right" />
      </div>
    </div>
  </section>
</PageLayout>
