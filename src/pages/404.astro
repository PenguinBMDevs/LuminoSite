---
import Button from '~/components/ui/Button.astro';
import PageLayout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';
---

<PageLayout
  metadata={{
    title: '页面不存在',
    description: '没有找到你访问的页面。返回 Lumino 首页，或前往功能一览了解这个用 Rust 构建的 MIDI 编辑器。',
    robots: { index: false, follow: false },
  }}
>
  <section class="relative overflow-hidden px-4 py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -top-40 left-1/2 h-96 w-[60rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl dark:bg-primary/20"
      >
      </div>
    </div>
    <div class="relative mx-auto max-w-xl text-center">
      <p class="font-mono text-sm font-semibold tracking-[0.3em] text-primary uppercase dark:text-accent">404</p>
      <h1 class="mt-4 font-heading text-4xl font-bold tracking-tight text-heading md:text-5xl">找不到这个页面</h1>
      <p class="mt-4 text-muted">你访问的链接可能已经失效，或者地址输入有误。</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button text="返回首页" href={getPermalink('/')} variant="primary" icon="tabler:home" />
        <Button
          text="浏览功能"
          href={getPermalink('/features')}
          variant="secondary"
          icon="tabler:arrow-right"
        />
      </div>
    </div>
  </section>
</PageLayout>
