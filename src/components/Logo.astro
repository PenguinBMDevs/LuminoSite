---
import { SITE } from '~/config';
import { getDictionary, type Lang } from '~/i18n/ui';
import { getLangFromPath, localizePath } from '~/i18n/utils';

export interface Props {
  class?: string;
  /** Hides the wordmark, leaving only the logo mark. */
  iconOnly?: boolean;
  lang?: Lang;
}

const { class: className = '', iconOnly = false } = Astro.props;
const lang = Astro.props.lang ?? getLangFromPath(Astro.url.pathname);
const t = getDictionary(lang);
---

<a
  href={localizePath('/', lang)}
  class:list={['group inline-flex items-center gap-2.5 no-underline', className]}
  aria-label={t.a11y.home}
>
  <img
    src={SITE.logo}
    alt=""
    width="32"
    height="32"
    class="h-8 w-8 shrink-0 transition-transform duration-200 group-hover:scale-105"
  />
  {!iconOnly && <span class="text-xl font-bold tracking-tight text-heading">{SITE.name}</span>}
</a>
