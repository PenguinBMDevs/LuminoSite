---
import { SITE } from '~/config';
import { getHomePermalink } from '~/utils/permalinks';

export interface Props {
  class?: string;
  /** Hides the wordmark, leaving only the glyph. */
  iconOnly?: boolean;
}

const { class: className = '', iconOnly = false } = Astro.props;
---

<a
  href={getHomePermalink()}
  class:list={['group inline-flex items-center gap-2.5 no-underline', className]}
  aria-label={`${SITE.name} 首页`}
>
  <svg
    viewBox="0 0 32 32"
    class="h-8 w-8 shrink-0 drop-shadow-sm transition-transform duration-200 group-hover:scale-105"
    role="img"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="lumino-mark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#6366f1"></stop>
        <stop offset="55%" stop-color="#8b5cf6"></stop>
        <stop offset="100%" stop-color="#22d3ee"></stop>
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#lumino-mark)"></rect>
    <rect x="8" y="17" width="15" height="3.2" rx="1.6" fill="#ffffff" fill-opacity="0.95"></rect>
    <rect x="11" y="11.2" width="13" height="3.2" rx="1.6" fill="#ffffff" fill-opacity="0.75"></rect>
    <rect x="8" y="22.8" width="8" height="3.2" rx="1.6" fill="#ffffff" fill-opacity="0.55"></rect>
  </svg>
  {
    !iconOnly && (
      <span class="text-xl font-bold tracking-tight text-heading">
        {SITE.name}
      </span>
    )
  }
</a>
