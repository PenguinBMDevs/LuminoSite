---
// Brand palette + typography tokens. Every colour in the site references these
// `--aw-*` variables, so re-skinning Lumino is a single-file exercise.
// Fonts themselves are self-hosted through @fontsource-variable (see Layout.astro).
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';
    --aw-font-mono: 'JetBrains Mono Variable';

    --aw-color-primary: rgb(79 70 229);
    --aw-color-secondary: rgb(67 56 202);
    --aw-color-accent: rgb(6 182 212);
    --aw-color-link: rgb(79 70 229);

    --aw-color-text-heading: rgb(2 6 23);
    --aw-color-text-default: rgb(15 23 42);
    --aw-color-text-muted: rgb(15 23 42 / 64%);

    --aw-color-bg-page: rgb(255 255 255);
    --aw-color-bg-page-dark: rgb(8 9 12);
    --aw-color-bg-surface: rgb(248 250 252);
    --aw-color-border: rgb(226 232 240);

    ::selection {
      background-color: rgb(199 210 254);
      color: rgb(2 6 23);
    }
  }

  .dark {
    --aw-color-primary: rgb(99 102 241);
    --aw-color-secondary: rgb(129 140 248);
    --aw-color-accent: rgb(34 211 238);
    --aw-color-link: rgb(165 180 252);

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(203 213 225 / 66%);

    --aw-color-bg-page: rgb(9 11 16);
    --aw-color-bg-page-dark: rgb(6 8 12);
    --aw-color-bg-surface: rgb(17 20 28);
    --aw-color-border: rgb(148 163 184 / 18%);

    ::selection {
      background-color: rgb(49 46 129);
      color: rgb(248 250 252);
    }
  }
</style>
