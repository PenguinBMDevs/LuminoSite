---
import { Icon } from 'astro-icon/components';

import Button from '~/components/ui/Button.astro';

import { APP } from '~/config';
import { getDictionary, type Lang } from '~/i18n/ui';
import { localizePath } from '~/i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const commands = [
  'git clone https://github.com/PenguinBMDevs/lumino-rs.git',
  'cd lumino-rs',
  'cargo build --release',
  'cargo run --release',
];
---

<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-40 left-1/2 h-80 w-[48rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl dark:bg-primary/20"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 md:py-20 lg:px-8">
    <h1 class="font-heading text-4xl leading-tighter font-bold tracking-tight text-balance text-heading md:text-5xl">
      {t.platforms.title}
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-pretty text-muted md:text-lg">{t.platforms.subtitle}</p>

    <div class="mt-8 flex flex-col items-center gap-3">
      <Button
        variant="primary"
        text={t.platforms.releaseButton}
        icon="tabler:brand-github"
        href={APP.releases}
        target="_blank"
      />
      <p class="flex flex-wrap items-center justify-center gap-2 text-xs text-muted">
        <span class="rounded-full border border-line bg-surface px-2.5 py-1 font-mono">
          {t.platforms.versionLabel} {APP.version}
        </span>
        <span>{t.platforms.versionNote}</span>
      </p>
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-16 lg:px-8">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <h2 class="font-heading text-2xl font-bold tracking-tight text-heading">{t.platforms.platformsHeading}</h2>
    <p class="max-w-xl text-sm leading-relaxed text-muted">{t.platforms.platformsHint}</p>
  </div>

  <ul class="mt-8 grid gap-4 md:grid-cols-3">
    {
      t.platforms.platforms.map((platform, index) => (
        <li class="card flex flex-col p-6" data-animate style={`--animate-delay: ${index * 60}ms`}>
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary ring-1 ring-primary/20">
              <Icon name={platform.icon} class="h-5 w-5" />
            </span>
            <h3 class="font-heading text-lg font-semibold text-heading">{platform.name}</h3>
          </div>

          <div class="mt-4 flex flex-wrap gap-1.5">
            {platform.archs.map((arch) => (
              <span class="rounded-md border border-line px-1.5 py-0.5 font-mono text-[11px] text-muted">{arch}</span>
            ))}
          </div>

          <p class="mt-4 text-sm leading-relaxed text-muted">{platform.note}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:py-16 lg:grid-cols-2 lg:gap-14 lg:px-8">
    <div>
      <h2 class="font-heading text-2xl font-bold tracking-tight text-heading">{t.platforms.sourceHeading}</h2>
      <p class="mt-3 leading-relaxed text-muted">{t.platforms.sourceSubtitle}</p>

      <h3 class="mt-8 text-xs font-semibold tracking-wide text-heading uppercase">{t.platforms.requirementsHeading}</h3>
      <ul class="mt-3 space-y-2.5 text-sm text-muted">
        {
          t.platforms.requirements.map((requirement) => (
            <li class="flex gap-2">
              <Icon name="tabler:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
              <span>{requirement}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rounded-2xl border border-line bg-slate-950 p-4 shadow-xl shadow-slate-950/10" data-animate>
      <div class="flex items-center gap-2 pb-3">
        <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
        <span class="ml-auto font-mono text-[11px] text-slate-400">{t.platforms.terminalLabel}</span>
      </div>

      <div class="space-y-1.5 border-t border-white/10 pt-3 font-mono text-sm leading-relaxed">
        {
          commands.map((command) => (
            <div class="flex items-start gap-2">
              <span class="shrink-0 select-none text-slate-500">$</span>
              <span class="break-all text-slate-200">{command}</span>
            </div>
          ))
        }
      </div>

      <p
        class="mt-4 flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-2 font-mono text-[11px] text-slate-400"
      >
        <Icon name="tabler:terminal-2" class="h-4 w-4 shrink-0 text-cyan-300" />
        {t.platforms.terminalNote}
      </p>
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
  <div
    class="flex flex-col gap-4 rounded-xl border border-line bg-page p-6 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-start gap-3">
      <Icon name="tabler:license" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
      <div>
        <h2 class="flex flex-wrap items-center gap-2 text-sm font-semibold text-heading">
          {t.platforms.licenseHeading}
          <span class="rounded-md border border-line bg-surface px-1.5 py-0.5 font-mono text-[11px] font-normal text-muted">
            {APP.licenseName}
          </span>
        </h2>
        <p class="mt-1.5 text-sm leading-relaxed text-muted">{t.platforms.licenseText}</p>
      </div>
    </div>

    <a
      href={APP.license}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-link hover:underline"
    >
      {t.platforms.licenseLink}
      <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
    </a>
  </div>

  <a
    href={localizePath('/', lang)}
    class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-muted transition hover:text-heading"
  >
    <Icon name="tabler:arrow-left" class="h-4 w-4" />
    {t.platforms.backHome}
  </a>
</section>
