---
import { Icon } from 'astro-icon/components';

import Button from '~/components/ui/Button.astro';

import { APP, SITE } from '~/config';
import { getDictionary, type Lang } from '~/i18n/ui';
import { localizePath } from '~/i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

// `Lumino: 新一代MIDI编辑器` — the product name is highlighted, the rest is plain.
const [name, ...rest] = t.home.title.split(':');
const remainder = rest.length > 0 ? `:${rest.join(':')}` : '';
---

<section class="relative flex min-h-[calc(100svh-4rem)] items-center justify-center overflow-hidden px-4 py-16">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute top-1/4 left-1/2 h-[26rem] w-[46rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl dark:bg-primary/20"
    >
    </div>
    <div class="absolute -bottom-24 right-4 h-56 w-56 rounded-full bg-accent/10 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-6xl text-center">
    <img src={SITE.logo} alt="" width="96" height="96" class="mx-auto h-24 w-24" />

    <h1
      class="mt-8 font-heading text-4xl leading-tighter font-bold tracking-tight text-balance text-heading sm:text-5xl md:text-6xl"
    >
      <span class="text-primary dark:text-accent">{name}</span>{remainder}
    </h1>

    <p class="mx-auto mt-6 max-w-xl text-pretty text-muted md:text-lg">{t.home.description}</p>

    <div class="mt-9 flex flex-col items-center gap-4">
      <!-- Download buttons always land on GitHub Releases. -->
      <Button variant="primary" text={t.home.cta} href={APP.releases} target="_blank" icon="tabler:download" />
      <a
        href={localizePath('/download/', lang)}
        class="inline-flex items-center gap-1 text-sm font-medium text-muted transition hover:text-heading"
      >
        {t.home.infoLink}
        <Icon name="tabler:arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
