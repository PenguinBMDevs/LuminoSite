---
import type { Widget } from '~/types';

export interface Props extends Widget {
  containerClass?: string;
}

const { id, isDark = false, containerClass = '', bg } = Astro.props;
---

<section
  class:list={[
    { dark: isDark },
    isDark ? 'border-y border-line bg-dark' : '',
    'relative not-prose scroll-mt-20',
  ]}
  {...id ? { id } : {}}>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <slot name="bg">{bg && <Fragment set:html={bg} />}</slot>
  </div>
  <div class:list={['relative mx-auto max-w-7xl px-4 py-14 text-default sm:px-6 md:py-20 lg:px-8', containerClass]}>
    <slot />
  </div>
</section>
