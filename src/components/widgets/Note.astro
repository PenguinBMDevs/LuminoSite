---
import { Icon } from 'astro-icon/components';

import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

import type { Note as Props } from '~/types';

const {
  title,
  text = '',
  icon = 'tabler:info-circle',
  link,
  id,
  isDark = false,
  classes = {},
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-3xl ${classes?.container ?? ''}`}>
  <div class="flex gap-4 rounded-xl border border-primary/20 bg-primary/5 p-5">
    <Icon name={icon} class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
    <div class="text-sm leading-relaxed text-muted">
      {title && <p class="mb-1 font-semibold text-heading">{title}</p>}
      <p set:html={text} />
      {
        link && (
          <a class="mt-2 inline-block font-medium text-link hover:underline" href={link.href} {...link.target ? { target: link.target, rel: 'noopener noreferrer' } : {}}>
            {link.text}
          </a>
        )
      }
    </div>
  </div>
</WidgetWrapper>
