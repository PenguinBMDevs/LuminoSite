---
import { Icon } from 'astro-icon/components';

import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

import type { Faqs as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  id,
  isDark = false,
  classes = {},
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-4xl ${classes?.container ?? ''}`}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline} />

  {
    items.length > 0 && (
      <div class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
        {items.map(({ title: itemTitle, description }, index) => (
          <details class="group px-5 py-4 sm:px-6" open={index === 0} data-animate>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-heading [&::-webkit-details-marker]:hidden">
              <span>{itemTitle}</span>
              <Icon
                name="tabler:chevron-down"
                class="h-5 w-5 shrink-0 text-muted transition-transform duration-200 group-open:rotate-180"
              />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted" set:html={description} />
          </details>
        ))}
      </div>
    )
  }

  {
    Astro.slots.has('default') && (
      <div class="mt-8 text-center">
        <slot />
      </div>
    )
  }
</WidgetWrapper>
