---
import { Icon } from 'astro-icon/components';

import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

import type { Stats as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  stats = [],
  id,
  isDark = false,
  classes = {},
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl ${classes?.container ?? ''}`}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline} />

  <div class="grid grid-cols-2 gap-8 md:grid-cols-4 md:gap-4 md:divide-x md:divide-line">
    {
      stats.map(({ amount, title: statTitle, icon }, index) => (
        <div
          class="flex flex-col items-center text-center md:px-4"
          data-animate
          style={`--animate-delay: ${index * 60}ms`}
        >
          {icon && <Icon name={icon} class="mb-3 h-6 w-6 text-accent" />}
          <div class="font-heading text-3xl font-bold tracking-tight text-heading md:text-4xl">{amount}</div>
          <div class="mt-2 text-sm text-muted">{statTitle}</div>
        </div>
      ))
    }
  </div>
</WidgetWrapper>
