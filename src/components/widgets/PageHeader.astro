---
import Button from '~/components/ui/Button.astro';
import type { PageHeader as Props } from '~/types';

const {
  badge,
  tagline,
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  actions = [],
  id,
} = Astro.props;
---

<section class="relative overflow-hidden border-b border-line not-prose" {...id ? { id } : {}}>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-40 left-1/2 h-96 w-[60rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl dark:bg-primary/20"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-24 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      {
        badge && (
          <span class="mb-5 inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold tracking-wide text-primary uppercase dark:text-indigo-200">
            {badge}
          </span>
        )
      }
      {
        tagline && (
          <p
            class="text-sm font-bold tracking-widest text-secondary uppercase dark:text-accent"
            set:html={tagline}
          />
        )
      }
      {
        title && (
          <h1
            class="mt-3 font-heading text-4xl leading-tighter font-bold tracking-tight text-balance text-heading md:text-5xl"
            set:html={title}
          />
        )
      }
      {
        subtitle && (
          <p class="mx-auto mt-5 max-w-2xl text-lg text-pretty text-muted" set:html={subtitle} />
        )
      }
      {
        actions.length > 0 && (
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            {actions.map((action) => (
              <Button {...action} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
