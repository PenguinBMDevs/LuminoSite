---
import { Icon } from 'astro-icon/components';

import Logo from '~/components/Logo.astro';

import { APP } from '~/config';
import { getDictionary, type Lang } from '~/i18n/ui';
import { localizePath } from '~/i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const year = new Date().getFullYear();

/** The downloads page is internal, the rest come from the dictionary (external). */
const navLinks = [
  { text: t.header.download, href: localizePath('/download/', lang), external: false },
  ...t.footer.links.map((link) => ({ ...link, external: true })),
];
---

<footer class="relative border-t border-line">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-3 text-sm leading-relaxed text-muted">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.linksHeading}>
        <p class="text-xs font-semibold tracking-wide text-heading uppercase">{t.footer.linksHeading}</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                  class="text-muted transition hover:text-heading hover:underline"
                >
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-line pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        {t.footer.rights.replace('{year}', String(year))}
        {' · '}
        <a
          href={APP.license}
          target="_blank"
          rel="noopener noreferrer"
          class="transition hover:text-heading hover:underline">{t.footer.licenseLine}</a
        >
      </p>
      <p class="flex items-center gap-1.5 font-mono">
        <Icon name="tabler:tag" class="h-3.5 w-3.5" />
        {APP.version}
      </p>
    </div>
  </div>
</footer>
