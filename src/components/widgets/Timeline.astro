---
import { Icon } from 'astro-icon/components';

import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

import type { TimelineEntry, Widget } from '~/types';

interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  items?: Array<TimelineEntry>;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  id,
  isDark = false,
  classes = {},
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-4xl ${classes?.container ?? ''}`}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline} />

  {
    items.length > 0 && (
      <ol class="relative ml-3 border-l border-line pl-6 md:ml-6 md:pl-8">
        {items.map(({ label, title: itemTitle, description, icon }, index) => (
          <li class="relative pb-8 last:pb-0" data-animate style={`--animate-delay: ${index * 60}ms`}>
            <span class="absolute top-1 -left-[31px] flex h-6 w-6 items-center justify-center rounded-full border border-line bg-page text-primary md:-left-[39px]">
              {icon ? <Icon name={icon} class="h-3.5 w-3.5" /> : <span class="h-1.5 w-1.5 rounded-full bg-primary" />}
            </span>
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-3">
              {label && <span class="font-mono text-xs tracking-wide text-accent uppercase">{label}</span>}
              {itemTitle && <h3 class="font-heading text-lg font-semibold text-heading">{itemTitle}</h3>}
            </div>
            {description && <p class="mt-1.5 text-sm leading-relaxed text-muted">{description}</p>}
          </li>
        ))}
      </ol>
    )
  }
</WidgetWrapper>
