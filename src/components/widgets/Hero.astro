---
import { Image } from 'astro:assets';

import Button from '~/components/ui/Button.astro';
import type { Hero as Props } from '~/types';

const {
  badge,
  tagline,
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image,
  id,
} = Astro.props;

const actionList = Array.isArray(actions) ? actions : [];
const imageSrc = typeof image === 'string' ? image : image?.src;
const imageAlt = typeof image === 'string' ? '' : (image?.alt ?? '');
---

<section class="relative overflow-hidden not-prose" {...id ? { id } : {}}>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-48 left-1/2 h-[34rem] w-[70rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl dark:bg-primary/20"
    >
    </div>
    <div class="absolute top-1/3 -right-24 h-72 w-72 rounded-full bg-accent/10 blur-3xl"></div>
    <div class="absolute bottom-24 left-0 h-56 w-56 rounded-full bg-secondary/10 blur-3xl dark:bg-secondary/20"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 pt-16 pb-14 sm:px-6 md:pt-24 md:pb-20 lg:px-8">
    <div class="max-w-4xl md:mx-auto md:text-center">
      {
        badge && (
          <span class="mb-5 inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold tracking-wide text-primary uppercase dark:bg-primary/20 dark:text-indigo-200">
            {badge}
          </span>
        )
      }
      {
        tagline && (
          <p
            class="text-base font-bold tracking-widest text-secondary uppercase dark:text-accent"
            set:html={tagline}
          />
        )
      }
      {
        title && (
          <h1
            class="mt-4 font-heading text-4xl leading-tighter font-bold tracking-tight text-balance text-heading sm:text-5xl md:text-[3.4rem]"
            set:html={title}
          />
        )
      }
      {
        subtitle && (
          <p
            class="mx-auto mt-6 max-w-2xl text-lg text-pretty text-muted md:text-xl"
            set:html={subtitle}
          />
        )
      }
      {
        (actionList.length > 0 || (!Array.isArray(actions) && actions)) && (
          <div class="mt-9 flex flex-col items-stretch justify-center gap-3 sm:flex-row md:items-center">
            {actionList.length > 0 ? (
              actionList.map((action) => <Button {...action} class="w-full sm:w-auto" />)
            ) : (
              <Fragment set:html={actions} />
            )}
          </div>
        )
      }
    </div>

    <Fragment set:html={content} />

    {
      imageSrc && (
        <div class="relative mx-auto mt-14 max-w-5xl" data-animate>
          <div class="overflow-hidden rounded-2xl border border-line bg-slate-950 shadow-2xl shadow-slate-950/20 ring-1 ring-black/5">
            <div class="flex items-center gap-2 border-b border-white/10 bg-slate-900/80 px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-rose-400/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
              <span class="ml-2 font-mono text-[11px] tracking-wide text-slate-400">Lumino · piano roll</span>
            </div>
            {typeof imageSrc === 'string' ? (
              <img
                src={imageSrc}
                alt={imageAlt}
                width={1920}
                height={1032}
                loading="eager"
                fetchpriority="high"
                class="h-auto w-full"
              />
            ) : (
              <Image
                src={imageSrc}
                alt={imageAlt}
                width={1920}
                height={1032}
                widths={[720, 1080, 1440, 1920]}
                sizes="(max-width: 768px) 100vw, (max-width: 1280px) 90vw, 1024px"
                loading="eager"
                fetchpriority="high"
                class="h-auto w-full"
              />
            )}
          </div>
        </div>
      )
    }
  </div>
</section>
