---
import { Icon } from 'astro-icon/components';

export interface Props {
  iconClass?: string;
}

const { iconClass = 'w-6 h-6' } = Astro.props;
---

<button
  type="button"
  data-aw-toggle-theme
  class="inline-flex items-center justify-center rounded-lg p-2.5 text-muted transition hover:bg-surface hover:text-heading focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
  aria-label="切换深色 / 浅色主题"
  aria-pressed="false"
>
  <Icon name="tabler:sun" class={`${iconClass} hidden dark:inline-block`} />
  <Icon name="tabler:moon" class={`${iconClass} inline-block dark:hidden`} />
</button>

<script>
  const STORAGE_KEY = 'aw-color-mode';

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-aw-toggle-theme]');
    if (!button) return;

    const root = document.documentElement;
    const isDark = root.classList.toggle('dark');
    root.style.colorScheme = isDark ? 'dark' : 'light';

    try {
      localStorage.setItem(STORAGE_KEY, isDark ? 'dark' : 'light');
    } catch {
      // Persisting the choice is best effort only.
    }

    button.setAttribute('aria-pressed', String(isDark));
  });
</script>
