---
/** Mobile menu trigger. The two bars morph into a cross via the `expanded` class. */
---

<button
  type="button"
  data-aw-toggle-menu
  class="relative flex h-10 w-10 items-center justify-center rounded-lg border border-line text-heading transition hover:bg-surface focus:outline-none focus-visible:ring-2 focus-visible:ring-primary lg:hidden"
  aria-label="打开导航菜单"
  aria-expanded="false"
  aria-controls="header-nav"
>
  <span class="sr-only">菜单</span>
  <span data-bar="top"></span>
  <span data-bar="middle"></span>
  <span data-bar="bottom"></span>
</button>
