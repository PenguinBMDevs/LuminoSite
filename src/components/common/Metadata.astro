---
import { I18N, METADATA } from '~/config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

export interface Props extends MetaData {
  /** Skips `METADATA.title.template`, useful for the home page title. */
  ignoreTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical,
  robots,
  description,
  keywords,
  openGraph,
  twitter,
} = Astro.props;

const pageTitle = title
  ? ignoreTitleTemplate
    ? title
    : METADATA.title.template.replace('%s', title)
  : METADATA.title.default;

const canonicalUrl = canonical ?? getCanonical(Astro.url.pathname);
const finalDescription = description ?? METADATA.description;
const finalKeywords = (keywords ?? METADATA.keywords ?? []).join(', ');

const doIndex = robots?.index ?? METADATA.robots.index ?? true;
const doFollow = robots?.follow ?? METADATA.robots.follow ?? true;

const images = openGraph?.images ?? METADATA.openGraph.images ?? [];
const [image] = images;

const ogType = openGraph?.type ?? METADATA.openGraph.type ?? 'website';
const ogSiteName = openGraph?.siteName ?? METADATA.openGraph.site_name ?? '';
const twitterCard = twitter?.cardType ?? METADATA.twitter.cardType ?? (image ? 'summary_large_image' : 'summary');
---

<title>{pageTitle}</title>
<meta name="description" content={finalDescription} />
{finalKeywords && <meta name="keywords" content={finalKeywords} />}
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={`${doIndex ? 'index' : 'noindex'}, ${doFollow ? 'follow' : 'nofollow'}`} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={ogSiteName} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={I18N.language} />
{
  image && (
    <>
      <meta property="og:image" content={getCanonical(image.url)} />
      {image.width && <meta property="og:image:width" content={String(image.width)} />}
      {image.height && <meta property="og:image:height" content={String(image.height)} />}
      {image.alt && <meta property="og:image:alt" content={image.alt} />}
    </>
  )
}

<meta name="twitter:card" content={twitterCard} />
{
  twitter?.site && <meta name="twitter:site" content={twitter.site} />
}
{
  twitter?.handle && <meta name="twitter:creator" content={twitter.handle} />
}
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={finalDescription} />
{image && <meta name="twitter:image" content={getCanonical(image.url)} />}
