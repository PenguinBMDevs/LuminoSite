---
import { METADATA, SITE } from '~/config';
import { defaultLang, dictionaries, getDictionary, type Lang } from '~/i18n/ui';
import { getLocaleLinks, getLocalizedUrl } from '~/i18n/utils';
import type { MetaData } from '~/types';

export interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  robots?: MetaData['robots'];
  canonical?: string;
}

const { lang, title, description, robots, canonical } = Astro.props;
const t = getDictionary(lang);

const doIndex = robots?.index ?? METADATA.robots.index;
const doFollow = robots?.follow ?? METADATA.robots.follow;

const pageTitle = title ? t.meta.titleTemplate.replace('%s', title) : SITE.name;

/*
 * `noindex` pages (the 404) have no meaningful canonical URL and must not emit
 * `hreflang` pointers to routes that are not generated.
 */
const canonicalUrl = canonical ?? (doIndex ? getLocalizedUrl(Astro.url.pathname, lang) : undefined);

const alternates = canonicalUrl ? getLocaleLinks(Astro.url.pathname) : [];
const defaultAlternate = alternates.find((alternate) => alternate.lang === defaultLang);
const alternatesOther = alternates.filter((alternate) => alternate.lang !== lang);

const image = METADATA.openGraph.images[0];
const twitterCard = METADATA.twitter.cardType ?? (image ? 'summary_large_image' : 'summary');
---

<title>{pageTitle}</title>
{description && <meta name="description" content={description} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<meta name="robots" content={`${doIndex ? 'index' : 'noindex'}, ${doFollow ? 'follow' : 'nofollow'}`} />

{
  canonicalUrl && alternates.map((alternate) => (
    <link rel="alternate" hreflang={dictionaries[alternate.lang].htmlLang} href={alternate.url} />
  ))
}
{defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.url} />}

<meta property="og:type" content={METADATA.openGraph.type} />
<meta property="og:site_name" content={METADATA.openGraph.siteName} />
<meta property="og:title" content={pageTitle} />
{description && <meta property="og:description" content={description} />}
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:locale" content={t.ogLocale} />
{
  alternatesOther.map((alternate) => (
    <meta property="og:locale:alternate" content={dictionaries[alternate.lang].ogLocale} />
  ))
}
{
  image && (
    <>
      <meta property="og:image" content={getLocalizedUrl(image.url, lang)} />
      <meta property="og:image:width" content={String(image.width)} />
      <meta property="og:image:height" content={String(image.height)} />
      <meta property="og:image:alt" content={image.alt ?? pageTitle} />
    </>
  )
}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={pageTitle} />
{description && <meta name="twitter:description" content={description} />}
{image && <meta name="twitter:image" content={getLocalizedUrl(image.url, lang)} />}
