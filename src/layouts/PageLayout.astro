---
import Footer from '~/components/widgets/Footer.astro';
import Header from '~/components/widgets/Header.astro';

import Layout from '~/layouts/Layout.astro';
import { getDictionary, type Lang } from '~/i18n/ui';
import type { MetaData } from '~/types';

export interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  robots?: MetaData['robots'];
  ignoreTitleTemplate?: boolean;
}

const { lang, title, description, robots, ignoreTitleTemplate = false } = Astro.props;
const t = getDictionary(lang);
---

<Layout
  lang={lang}
  title={title}
  description={description}
  robots={robots}
  ignoreTitleTemplate={ignoreTitleTemplate}
>
  <slot name="head" slot="head" />
  <a
    href="#main"
    class="sr-only rounded-md bg-primary px-4 py-2 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
  >
    {t.a11y.skipToContent}
  </a>
  <Header lang={lang} />
  <main id="main" class="flex-1">
    <slot />
  </main>
  <Footer lang={lang} />
</Layout>
