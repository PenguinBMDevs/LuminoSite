---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '~/assets/styles/tailwind.css';

import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Intersect from '~/components/common/Intersect.astro';
import Metadata from '~/components/common/Metadata.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import Favicons from '~/components/Favicons.astro';

import { getDictionary, type Lang } from '~/i18n/ui';
import type { MetaData } from '~/types';

export interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  robots?: MetaData['robots'];
}

const { lang, title, description, robots } = Astro.props;
const t = getDictionary(lang);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <ApplyColorMode />
    <CustomStyles />
    <Metadata lang={lang} title={title} description={description} robots={robots} />
    <Favicons />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-page font-sans tracking-tight text-default antialiased">
    <slot />
    <Intersect />
  </body>
</html>
